/* this is my custom theme based on: */
/* ROFI SQUARED THEME USING THE EVERFOREST PALETTE  */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
  font:   "GohuFont uni14 Nerd Font Mono 11";

  bg0:     #000000;
  bg1:     #000000;
  fg0:     #80d9b5;

  accent-color:     #489c7a;
  urgent-color:     #DBBC7F;

  background-color:   transparent;
  text-color:         @fg0;

  margin:     0;
  padding:    0;
  spacing:    0;
}

window {
  location:   center;
  width:      720;

  background-color: @bg0;
  padding:          8px;
  border:           1px solid;
  border-color:     #141a19;
}

textbox-prompt-colon {
  expand: false;
  str: ">>";
}

inputbar {
  spacing:    8px;
  padding:    8px;

  background-color:   @bg1;
  children: [ textbox-prompt-colon, prompt, entry ];
}

prompt, entry, element-icon, element-text {
  vertical-align: 0.5;
}

prompt {
  enabled: false;
  text-color: @accent-color;
}

entry {
  placeholder: "...";
  placeholder-color: #cccccc50;
}

textbox {
  padding:            8px;
  background-color:   @bg1;
}

listview {
  padding:    4px 0;
  lines:      8;
  columns:    1;

  fixed-height:   false;
}

element {
  padding:    8px;
  spacing:    8px;
}

element normal normal {
  text-color: @fg0;
}

element normal urgent {
  text-color: @urgent-color;
}

element normal active {
  text-color: @accent-color;
}

element alternate active {
  text-color: @accent-color;
}

element selected {
  text-color: @bg0;
}

element selected normal, element selected active {
  background-color:   @accent-color;
}

element selected urgent {
  background-color:   @urgent-color;
}

element-icon {
  size:   0.8em;
}

element-text {
  text-color: inherit;
}
