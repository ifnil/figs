[global]
font = "GohuFont uni14 Nerd Font Mono 11"
frame_color = "#489c7a"
timeout = 3
padding = 8
markup = yes

# The format of the message.  Possible variables are:
#   %a  appname
#   %s  summary
#   %b  body
#   %i  iconname (including its path)
#   %I  iconname (without its path)
#   %p  progress value if set ([  0%] to [100%]) or nothing
format = "%s %p\n%b"

[shortcuts]
# Shortcuts are specified as [modifier+][modifier+]...key
# Available modifiers are "ctrl", "mod1" (the alt-key), "mod2",
# "mod3" and "mod4" (windows-key).

  close = mod1+space
  close_all = ctrl+mod1+space
  history = ctrl+mod4+h
  context = ctrl+mod1+c

[urgency_low]
background = "#000000"
frame_color = "#489c7a"

[urgency_normal]
background = "#000000"
frame_color = "#489c7a"

[urgency_critical]
background = "#000000"
frame_color = "#6c383b"


